# --- Database -------------------------------------------------------------
DATABASE_URL=postgres://veyrona:password@localhost:5432/veyrona
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# --- Authorize.Net --------------------------------------------------------
# sandbox | production
AUTHORIZE_NET_ENVIRONMENT=sandbox
AUTHORIZE_NET_LOGIN_ID=
AUTHORIZE_NET_TRANSACTION_KEY=
# Public client key used by Accept.js in the browser (safe to expose)
VITE_AUTHORIZE_NET_CLIENT_KEY=
VITE_AUTHORIZE_NET_ENVIRONMENT=sandbox
# Signature key from Authorize.Net > Settings > Webhooks (for webhook verification)
AUTHORIZE_NET_SIGNATURE_KEY=

# --- Store settings -------------------------------------------------------
STORE_NAME=Veyrona Labs
STORE_URL=https://veyronalabs.ca
FREE_SHIPPING=true

# --- Email (SMTP) ---------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
ORDER_FROM_EMAIL=orders@veyronalabs.ca
ORDER_ALERT_EMAIL=orders@veyronalabs.ca

# --- Admin ----------------------------------------------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=
